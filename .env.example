# Fork tests under test/fork/ need an RPC, the external-address network, and one concrete deployment registry.
# The fork suites revert when either is unset, the map file is missing, or the RPC does not
# answer — they run or they fail, they never skip. Targets that run test/fork/ (make test, make test-fork,
# make coverage, make snapshot, make snapshot-diff) therefore fail without them. Make loads this file
# for every target, and a value here — even a blank one — overrides the same variable exported in your
# shell; make command-line assignments override both.
ETH_RPC_URL=
NETWORK=mainnet
FORK_REGISTRY=

# Optional: pin the fork to a fixed block instead of latest — e.g. to replay a failure at the exact block
# ForkTest logged (`[fork] block: <n>`). Unset means latest, which is the default.
FORK_BLOCK=

# Optional: pin the oracle-price seed. Setups log the seed they picked (`TEST_SEED: <n>`); export it to
# reproduce a run. Unset means a random seed per run.
TEST_SEED=

# Optional: Etherscan API key for contract verification flows.
ETHERSCAN_API_KEY=

# Deployment wrappers (`make deploy-*`). Keep this secret local; Make reads it but never prints it.
RPC_URL=
DEPLOYER_PRIVATE_KEY=
