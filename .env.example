# RPC_URL and HOODI_RPC_URL are the mainnet and Hoodi archive RPCs of the fork tests. make test-fork runs each market
# in its own Forge run, and a market whose network's variable is unset fails; make test-fork-<network>-<market> runs one market. With
# RUN=<network> on the command line, the fork suites bind the network's recorded markets at RPC_URL's latest block and
# create an inert one; add PREPARE=false to test existing state without preparation. RUN from .env or the environment
# does not select.
#
# Make loads this file for every target. Precedence is command-line assignment, exported environment, this
# file, then the Makefile default.
RPC_URL=
HOODI_RPC_URL=

# Optional: the blocks the mainnet and Hoodi forks run at; unset means the network's latest block. A run logs its
# block (`[fork] <network> at block <n>`), so a failure replays at it, and forge caches the RPC responses of a set block.
FORK_BLOCK=
HOODI_FORK_BLOCK=

# Optional: pin the oracle-price seed. Setups log the seed they picked (`TEST_SEED: <n>`); export it to
# reproduce a run. Unset means a random seed per run.
TEST_SEED=

# Optional: pin Foundry's fuzz/invariant inputs independently from TEST_SEED.
FOUNDRY_FUZZ_SEED=

# Optional: explorer API key for forge script --verify.
ETHERSCAN_API_KEY=
