# Fork tests under test/fork/ need an RPC to fork and a path to that network's
# deployed addresses JSON map. Set both (run `make fork-test`); the suites self-skip when either is unset.
ETH_RPC_URL=
DEPLOYMENT=deployments/deployed-mainnet.json

# Optional: pin the fork to a fixed block instead of latest — e.g. to replay a failure at the exact block
# ForkTest logged (`[fork] block: <n>`). Unset means latest, which is the default.
FORK_BLOCK=

# Optional: pin the oracle-price seed. Setups log the seed they picked (`TEST_SEED: <n>`); export it to
# reproduce a run. Unset means a random seed per run.
TEST_SEED=

# Optional: Etherscan API key for contract verification flows.
ETHERSCAN_API_KEY=
