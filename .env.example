# RPC_URL is the upstream mainnet archive RPC for fresh fork tests. Each suite creates and prepares its own
# Forge fork; no Anvil or provisioning step is needed. FORK_BLOCK optionally pins the source block.
# make test-fork uses a fresh stack unless RUN=<run> is supplied on the Make command line.
# With RUN, it prepares missing/inert WETH/wstETH markets privately over the existing mainnet protocol;
# add PREPARE=false on the command line to test existing state without preparation (also supports Hoodi).
# RPC_URL must hold that deployment. RUN and PREPARE from .env or the environment do not select these modes.
# RUN selects a Solidity description registered in RecordedDeployment.
# Make sets DEPLOYMENT_RUN and PREPARE_MARKETS internally.
#
# Make loads this file for every target. Precedence is command-line assignment, exported environment, this
# file, then the Makefile default.
RPC_URL=

# Reviewed EasyTrack motion inputs for acceptance of a production run. Keep these commented until known: an empty
# exported bool/address is not a value.
# ACCEPTANCE_ENABLE_SETTLEMENT=true
# ACCEPTANCE_PAUSER_COMMITTEE=<reviewed-address>

# Optional: pin the fork to a fixed block instead of latest — e.g. to replay a failure at the exact block
# ForkTest logged (`[fork] block: <n>`). Unset means latest, which is the default.
FORK_BLOCK=

# Optional: pin the oracle-price seed. Setups log the seed they picked (`TEST_SEED: <n>`); export it to
# reproduce a run. Unset means a random seed per run.
TEST_SEED=

# Optional: pin Foundry's fuzz/invariant inputs independently from TEST_SEED.
FOUNDRY_FUZZ_SEED=

# Optional: explorer API key for forge script --verify.
ETHERSCAN_API_KEY=
