# Fork tests and deployment wrappers share one RPC. Fork tests bind to a deploy run's artifacts under
# deployed/<ARTIFACTS_DIR>/: the run records its own chain_id and network, so there is no network selector
# here. The suites revert when either input is missing, the run has no protocol.toml, or the recorded
# chain_id does not match the forked chain — they run or they fail, they never skip. Make loads this file
# for every target, and a value here — even a blank one — overrides the same variable exported in your
# shell; make command-line assignments override both.
RPC_URL=
ARTIFACTS_DIR=

# Optional: pin the fork to a fixed block instead of latest — e.g. to replay a failure at the exact block
# ForkTest logged (`[fork] block: <n>`). Unset means latest, which is the default.
FORK_BLOCK=

# Optional: pin the oracle-price seed. Setups log the seed they picked (`TEST_SEED: <n>`); export it to
# reproduce a run. Unset means a random seed per run.
TEST_SEED=

# Required by deployment wrappers unless VERIFY=false.
ETHERSCAN_API_KEY=

# Deployment wrappers (`make deploy-*`). Keep this secret local; Make reads it but never prints it.
DEPLOYER_PRIVATE_KEY=
VERIFY=true
